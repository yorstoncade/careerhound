# SQLite file, relative to prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Public base URL used in email links
APP_URL="http://localhost:3000"

# SMTP for alert emails. Leave SMTP_HOST empty in development:
# emails are then written as .eml files to ./outbox instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="JobScout <alerts@example.com>"
