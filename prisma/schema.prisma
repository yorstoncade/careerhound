generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Company {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  ats           String // greenhouse | lever | ashby | workable | smartrecruiters | workday | careers-page
  token         String // the platform's board id; for careers-page, the careers URL
  website       String?
  careersUrl    String? // the URL it was added with, kept after upgrading to a platform
  scrapeMethod  String? // platform | json-ld | html | rendered
  logoUrl       String?
  lastScrapedAt DateTime?
  lastError     String?
  jobs          Job[]

  @@unique([ats, token])
}

model Job {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId      String
  title           String
  department      String?
  location        String
  remote          Boolean   @default(false)
  employmentType  String?
  seniority       String?
  salaryMin       Int?
  salaryMax       Int?
  salaryCurrency  String?
  descriptionText String
  applyUrl        String
  postedAt        DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  isActive        Boolean   @default(true)

  @@unique([companyId, externalId])
  @@index([isActive, firstSeenAt])
  @@index([companyId])
}

model Alert {
  id           String    @id @default(cuid())
  email        String
  query        String // filters as a URL query string, e.g. "q=engineer&remote=1"
  frequency    String    @default("daily")
  confirmed    Boolean   @default(false)
  confirmToken String    @unique
  unsubToken   String    @unique
  lastSentAt   DateTime?
  createdAt    DateTime  @default(now())
}
